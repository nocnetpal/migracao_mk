        <!-- ============ DETALHES panel ============ -->
        <mxCell id="50" value="Detalhes" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="10" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="51" value="1 — NE8000 &quot;BGP_NETPAL&quot;&#xa;- Core BGP/OSPF de produção — intacto&#xa;- CGNAT de assinantes&#xa;- Terminação QinQ dos POPs — intacto&#xa;- Dono do 177.72.104.0/27 + firewall (decisão #9)&#xa;- NOVO: SVI + OSPF area1 de TODAS as VLANs de&#xa;  acesso (27 QinQ + 3 simples) — decisão #13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="52" value="2 — DM4170 — 24GX+12XS&#xa;- Só QinQ termination (outer=site, inner=serviço)&#xa;- Entrega tudo em trunk 802.1q pro NE8000&#xa;- 🆕 Agrega fisicamente POPs + servidores locais&#xa;- Nenhuma SVI, nenhum OSPF (decisão #13)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="400" height="100" as="geometry" />
        </mxCell>

        <mxCell id="53" value="3 — CCR1036 (Mikrotik CCR1036-8G-2S+)&#xa;- NAT: SRC-NAT geral + DST-NAT (Dude, TS SIX)&#xa;- VPN de equipe: WireGuard somente pós-migração&#xa;- Automações: descartadas (decisão #6)&#xa;- 🆕 Único uplink: trunk DM4170 (VLAN 16 + gerência)&#xa;  — correção 2026-08-06, sem link direto c/ NE8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="280" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="54" value="4 — Rede de acesso (QinQ)&#xa;⛔ fora do escopo — nenhuma alteração" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="410" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="55" value="5 — Servidores locais&#xa;- TS SIX · Proxmox CDNTV · DNS recursivo&#xa;- Callcenter/Zabbix · Gerência OLT ZTE&#xa;- 🆕 cobre via DM4170 (transceiver SFP-RJ45,&#xa;  a confirmar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="480" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="56" value="6 — RB3011 &quot;GW Servidores&quot; (mesmo chassi do RB2011)&#xa;- Agregação L3, ~50 VLANs QinQ&#xa;- NAT, firewall, VPNs&#xa;❌ sai — funções herdadas acima" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="580" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="57" value="7 — RB2011 &quot;RB Bridge Servidores&quot; (mesmo chassi do RB3011)&#xa;- Switch L2 burro dos servidores&#xa;❌ sai — DM4170 assume a agregação física" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="670" width="400" height="70" as="geometry" />
        </mxCell>

